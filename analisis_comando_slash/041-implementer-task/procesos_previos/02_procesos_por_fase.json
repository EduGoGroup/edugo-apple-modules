  "manejo_errores": {
    "estrategia": "Try-catch por fase con fail de sesión y re-throw. Errores fatales terminan la ejecución. Algunos errores son no-fatales (búsqueda de docs, validación de código).",
    "output_error": { "success": false, "error": "CONTEXT_RESOLUTION_FAILED (ejemplo)" },
    "patron": "En fases críticas (3, 4, 6, 8): completeStep(false, error) -> fail_session -> throw. En fases opcionales (5, 7): log warning -> completeStep(true) -> continuar"
  },
  "funciones_auxiliares": [
    { "nombre": "startStep", "proposito": "Iniciar un nuevo paso en el tracking de la sesión", "parametros": ["stepName", "stepOrder"], "retorno": "step_id" },
    { "nombre": "logStep", "proposito": "Registrar un mensaje de log en el paso actual", "parametros": ["message", "level"], "retorno": "void" },
    { "nombre": "completeStep", "proposito": "Marcar el paso actual como completado (exitoso o fallido)", "parametros": ["success", "errorMessage"], "retorno": "void" }
  ]
